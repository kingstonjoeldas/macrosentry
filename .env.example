# Hugging Face API (optional - free tier doesn't require auth for some models)
HUGGINGFACE_API_KEY=

# Supabase (sign up at https://supabase.com, free tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Alpha Vantage for futures price data (free tier at https://www.alphavantage.co)
ALPHA_VANTAGE_API_KEY=

# Optional: Fed news API (example, if using NewsAPI)
# NEWSAPI_KEY=

# Logging
LOG_LEVEL=INFO
